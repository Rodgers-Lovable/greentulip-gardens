# Umami Analytics Configuration
VITE_UMAMI_SCRIPT_SRC=https://your-umami-instance.com/script.js
VITE_UMAMI_WEBSITE_ID=your-website-id-here

# Resend (server-only: no VITE_ prefix, never exposed to the browser)
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx
# Sender address. Its domain must be verified in Resend.
# For quick testing use: GreenTulip Gardens <onboarding@resend.dev>
RESEND_FROM_EMAIL=GreenTulip Gardens <website@greentulip.co.ke>
# Where form submissions are delivered. Comma-separate for several inboxes.
ENQUIRY_TO_EMAIL=info@greentulip.co.ke
